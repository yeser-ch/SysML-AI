const readline = require("readline"); // reads input line-by-line from the terminal
const https    = require("https");    // makes HTTPS requests to the Gemini API

const CONFIG = {
  /** Active Gemini model – overridable at runtime with /model */
  model: "gemini-2.5-flash",

  /** Parameters sent to the API on every request */
  generationConfig: {
    temperature:     0.9,   // creativity: 0 = strict/deterministic, 1 = very creative
    topK:            40,    // limits the pool of tokens the model picks from
    topP:            0.95,  // nucleus sampling – keeps the top 95% probability mass
    maxOutputTokens: 2048   // maximum length of each reply
  }
};

const C = {
  reset:  "\x1b[0m",
  bold:   "\x1b[1m",
  dim:    "\x1b[2m",
  green:  "\x1b[32m",  // messages
  cyan:   "\x1b[36m",  // Gemini messages
  yellow: "\x1b[33m",  // system info / hints
  red:    "\x1b[31m",  // errors
  grey:   "\x1b[90m"   // separators and prompts
};

/**
 * conversationHistory
 * Full multi-turn history in the Gemini API format.
 * The entire array is sent with every request so the model
 * remembers what was said earlier in the conversation.
 *
 * Each entry: { role: "user" | "model", parts: [{ text: string }] }
 *
 * @type {Array<{role: string, parts: Array<{text: string}>}>}
 */
const conversationHistory = [];

/** Stores the API key once resolved (from args or user input) */
let API_KEY = "";

/**Read input Line */
const rl = readline.createInterface({
  input:  process.stdin,
  output: process.stdout
});


/**
 * main()
 * Runs on startup:
 *   1. Print the welcome banner
 *   2. Get the API key (from CLI argument or interactive prompt)
 *   3. Start the chat loop
 */
async function main() {
  printBanner();

  // Check if an API key was passed as a command-line argument
  // e.g.  node gemini-terminal.js AIza...
  if (process.argv[2]) {
    API_KEY = process.argv[2].trim();
    print("system", `API key loaded from argument.`);
  } else {
    // Otherwise ask the user to type it in
    API_KEY = await prompt(
      `${C.yellow}Paste your Google AI Studio API key: ${C.reset}`
    );
  }

  // Basic validation
  if (!API_KEY || !API_KEY.startsWith("AIza")) {
    print("error", "That doesn't look like a valid Google API key (should start with 'AIza').");
    print("system", "Continuing anyway – the API will tell you if it's wrong.");
  }

  print("system", `Model: ${C.bold}${CONFIG.model}${C.reset}  |  Type ${C.yellow}/help${C.reset} for commands.\n`);

  // Start the interactive chat loop
  chatLoop();
}


function chatLoop() {
  // Show the input prompt
  rl.question(`${C.green}${C.bold}You${C.reset} ${C.grey}›${C.reset} `, async (input) => {

    const text = input.trim();

    // ── Ignore empty input ─────────────────────────────────
    if (!text) {
      chatLoop(); // just re-prompt
      return;
    }

    // ── Handle slash commands ──────────────────────────────
    if (text.startsWith("/")) {
      const handled = handleCommand(text);
      if (!handled) chatLoop(); // command handled, loop again
      return;                   // /exit sets handled = true and exits
    }

    // ── Regular message: send to Gemini ───────────────────
    conversationHistory.push({
      role:  "user",
      parts: [{ text }]
    });

    // Show a "thinking" indicator while waiting
    process.stdout.write(`${C.cyan}${C.bold}Gemini${C.reset} ${C.grey}› ${C.dim}thinking...${C.reset}`);

    try {
      const reply = await callGemini(API_KEY, CONFIG.model, conversationHistory);

      // Save the model reply to history
      conversationHistory.push({
        role:  "model",
        parts: [{ text: reply }]
      });

      // Clear the "thinking..." line, then print the reply
      clearLine();
      print("gemini", reply);

    } catch (err) {
      clearLine();
      print("error", err.message);
    }

    // Loop back for next input
    chatLoop();
  });
}

/**
 * handleCommand(input)
 * Parses and executes a /command string.
 *
 * @param {string} input  – the raw input string starting with "/"
 * @returns {boolean}     – true if the program should exit, false otherwise
 */
function handleCommand(input) {
  // Split into command name and optional arguments
  // e.g. "/model gemini-1.5-pro"  →  cmd = "model", args = "gemini-1.5-pro"
  const [cmd, ...rest] = input.slice(1).split(" ");
  const args = rest.join(" ").trim();

  switch (cmd.toLowerCase()) {

    // ── /exit or /quit ──────────────────────────────────────
    case "exit":
    case "quit":
      print("system", "Goodbye! 👋");
      rl.close();
      process.exit(0);
      return true; // signals the caller to stop looping

    // ── /clear ──────────────────────────────────────────────
    case "clear":
      conversationHistory.length = 0; // empty the array in-place
      print("system", "Conversation history cleared.");
      break;

    // ── /model <name> ───────────────────────────────────────
    case "model":
      if (!args) {
        print("system", `Current model: ${C.bold}${CONFIG.model}${C.reset}`);
        print("system", "Usage: /model gemini-1.5-pro");
      } else {
        CONFIG.model = args;
        print("system", `Model switched to: ${C.bold}${CONFIG.model}${C.reset}`);
      }
      break;

    // ── /help ───────────────────────────────────────────────
    case "help":
      printHelp();
      break;

    // ── Unknown command ─────────────────────────────────────
    default:
      print("error", `Unknown command: /${cmd}  (type /help for a list)`);
      break;
  }

  return false; // continue the chat loop
}


/**
 * callGemini(apiKey, model, contents)
 * Sends the conversation history to the Gemini generateContent
 * endpoint over HTTPS and resolves with the reply text.
 *
 * We use the built-in `https` module so this script works on
 * any Node.js version without installing any packages.
 *
 * Endpoint:
 *   POST https://generativelanguage.googleapis.com/v1beta/models
 *        /{model}:generateContent?key={apiKey}
 *
 * @param {string}   apiKey   – Google AI Studio key
 * @param {string}   model    – Gemini model ID
 * @param {object[]} contents – conversation history array
 * @returns {Promise<string>} – the model's reply text
 */
function callGemini(apiKey, model, contents) {
  return new Promise((resolve, reject) => {

    // Build the JSON request body
    const body = JSON.stringify({
      contents,
      generationConfig: CONFIG.generationConfig
    });

    // HTTPS request options
    const options = {
      hostname: "generativelanguage.googleapis.com",
      path:     `/v1beta/models/${encodeURIComponent(model)}:generateContent?key=${encodeURIComponent(apiKey)}`,
      method:   "POST",
      headers: {
        "Content-Type":   "application/json",
        "Content-Length": Buffer.byteLength(body) // required by the server
      }
    };

    // Create the request
    const req = https.request(options, (res) => {
      let rawData = "";

      // Collect response chunks as they arrive
      res.on("data", (chunk) => { rawData += chunk; });

      // Once the full response is received, parse it
      res.on("end", () => {
        try {
          const data = JSON.parse(rawData);

          // Handle HTTP-level errors (e.g. 400 Bad Request, 403 Forbidden)
          if (res.statusCode !== 200) {
            const msg = data?.error?.message || `HTTP ${res.statusCode}`;
            return reject(new Error(msg));
          }

          // Extract the reply text from the nested response
          const candidate = data?.candidates?.[0];

          if (!candidate) {
            return reject(new Error("No candidates returned by the API."));
          }

          // Safety block (e.g. content policy violation)
          if (candidate.finishReason === "SAFETY") {
            return reject(new Error("Reply blocked by Gemini safety filters."));
          }

          const replyText = candidate?.content?.parts?.[0]?.text;
          if (!replyText) {
            return reject(new Error("API returned an empty reply."));
          }

          resolve(replyText);

        } catch (parseError) {
          reject(new Error(`Failed to parse API response: ${parseError.message}`));
        }
      });
    });

    // Handle network-level errors (e.g. no internet connection)
    req.on("error", (err) => {
      reject(new Error(`Network error: ${err.message}`));
    });

    // Send the request body and close the connection
    req.write(body);
    req.end();
  });
}

/**
 * print(type, message)
 * Prints a labelled, coloured line to the terminal.
 *
 * @param {"gemini"|"system"|"error"} type
 * @param {string} message
 */
function print(type, message) {
  switch (type) {
    case "gemini":
      // Add a blank line before long AI replies for readability
      console.log(`\n${C.cyan}${C.bold}Gemini${C.reset} ${C.grey}›${C.reset} ${message}\n`);
      break;
    case "system":
      console.log(`${C.yellow}  ℹ ${message}${C.reset}`);
      break;
    case "error":
      console.log(`${C.red}  ✖ ${message}${C.reset}`);
      break;
    default:
      console.log(message);
  }
}

/**
 * prompt(question)
 * Wraps rl.question() in a Promise so we can await it.
 *
 * @param {string} question – text shown before the cursor
 * @returns {Promise<string>} – resolves with the user's input
 */
function prompt(question) {
  return new Promise((resolve) => {
    rl.question(question, (answer) => resolve(answer.trim()));
  });
}

/**
 * clearLine()
 * Erases the current terminal line (used to remove "thinking...").
 * Uses ANSI escape codes supported by most modern terminals.
 */
function clearLine() {
  process.stdout.write("\r\x1b[K"); // \r = go to line start, \x1b[K = erase to end
}

/**
 * printBanner()
 * Prints the ASCII welcome header when the script starts.
 */
function printBanner() {
  console.log(`
${C.cyan}${C.bold}  ╔══════════════════════════════════════╗
  ║        Gemini Terminal Chat          ║
  ╚══════════════════════════════════════╝${C.reset}
${C.grey}  Powered by Google Generative AI API${C.reset}
  `);
}

/**
 * printHelp()
 * Prints all available slash commands.
 */
function printHelp() {
  console.log(`
${C.yellow}  Available commands:${C.reset}
  ${C.bold}/help${C.reset}              Show this help message
  ${C.bold}/clear${C.reset}             Clear conversation history
  ${C.bold}/model ${C.grey}<name>${C.reset}      Switch the Gemini model
                     e.g. /model gemini-1.5-pro
  ${C.bold}/exit${C.reset}              Quit the program
  `);
}


main();
