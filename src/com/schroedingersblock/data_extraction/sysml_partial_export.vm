# ========================================================================
# VELOCITY TEMPLATE: Partial SysML Model Export
# ========================================================================
# Exports a subset of model elements centered around a user-selected element.
# Traverses relationships bidirectionally with configurable relationship types.
# ========================================================================
# ========================================================================
# SECTION 1: CONFIGURATION (Must be before any output)
# ========================================================================
# Center element from Java context (provided by DataExtractionService)
#set($CENTER_ELEMENT = $!centerElement)##
#set($IS_CENTER_SET = ($CENTER_ELEMENT != ""))##
# Enable partial export mode
#set($PARTIAL_EXPORT_ENABLED = $IS_CENTER_SET)##
# Traversal depth limit (prevent infinite loops in cyclic dependencies)
#set($MAX_DEPENDENCY_DEPTH = 5)##
# Maximum depth for sibling element collection (horizontal expansion via parent)
#set($MAX_SIBLING_DEPTH = 2)##
# Include owned child elements (downward parent-child hierarchy)
#set($INCLUDE_OWN_ELEMENTS = true)##
# Include owner hierarchy (upward parent-child hierarchy)
#set($INCLUDE_PARENT_HIERARCHY = true)##
# ========================================================================
# Relationship Traversal: Type-dependent flags set per element in macro
# ========================================================================
# Note: $SEARCH_* flags are determined by element type in collectDependencyLinks()
# No global INCLUDE_* flags needed anymore
# ========================================================================
# Global Data Structures (O(1) cycle detection with HashMap)
# ========================================================================
#set($collectedElements = {})##
#set($visitedIndex = {})##
#set($SEARCH_DEPENDENCIES = false)##
#set($SEARCH_ASSOCIATIONS = false)##
#set($SEARCH_GENERALIZATIONS = false)##
#set($SEARCH_PROPERTIES = false)##
#set($SEARCH_PORTS = false)##
#set($SEARCH_CONNECTORS = false)##
#set($SEARCH_INTERFACE_REALIZATION = false)##
#set($SEARCH_ACTIVITY_STRUCTURE = false)##
#set($SEARCH_BEHAVIOR_CALLS = false)##
# ========================================================================
# SECTION 2: JSON OUTPUT STRUCTURE
# ========================================================================
{
  "global_context": {
    "project_name": "$!project.name",
    "export_info": "SysML Partial Graph Export"
  },
  "elements": [
#if($PARTIAL_EXPORT_ENABLED)##
#initializePartialExport()##
#exportCollectedElements()##
#end##
]
##
## ====================================================================
## MACRO: collectOwnedElements
## ====================================================================
## Recursively collect owned child elements up to maxDepth
## 
## Parameters:
##   $elem - Element to process
##   $maxDepth - Maximum recursion depth
##   $currentDepth - Current depth in recursion
##
## Performance: O(m) where m = elements within max depth
##
#macro(collectOwnedElements $elem $maxDepth $currentDepth)##
#if($currentDepth <= $maxDepth)##
#foreach($child in $elem.ownedElement)##
#if(!$visitedIndex.containsKey($child.ID))##
#set($void = $visitedIndex.put($child.ID, true))##
#set($void = $collectedElements.put($child.ID, {"element": $child, "depth": $currentDepth, "source": "owned_element"}))##
#set($nextDepth = $currentDepth + 1)##
#collectOwnedElements($child $maxDepth $nextDepth)##
#end##if(!visitedIndex.containsKey($child.ID))##
#end##foreach($child in $elem.ownedElement)##
#end##if($currentDepth <= $maxDepth)##
#end##macro(collectOwnedElements)##
##
## ====================================================================
## MACRO: collectParentElements
## ====================================================================
## Recursively collect owner (parent) elements up to maxDepth
## Traverses upward through the hierarchy via $elem.owner
##
## Parameters:
##   $elem - Element to process
##   $maxDepth - Maximum recursion depth
##   $currentDepth - Current depth in recursion
##
## Performance: O(m) where m = elements in parent hierarchy up to max depth
##
#macro(collectParentElements $elem $maxDepth $currentDepth)##
#if($currentDepth <= $maxDepth)##
#if($elem.owner)##
#set($parentElem = $elem.owner)##
#if(!$visitedIndex.containsKey($parentElem.ID))##
#set($void = $visitedIndex.put($parentElem.ID, true))##
#set($void = $collectedElements.put($parentElem.ID, {"element": $parentElem, "depth": $currentDepth, "source": "parent_hierarchy"}))##
## ========================================================================
## SIBLING EXPANSION: VOR rekursivem Aufruf - auf dieser Tiefe Geschwister sammeln
## ========================================================================
#if($currentDepth <= $MAX_SIBLING_DEPTH)##
#foreach($sibling in $parentElem.ownedElement)##
#if($sibling.ID != $elem.ID)##
#if(!$visitedIndex.containsKey($sibling.ID))##
#set($void = $visitedIndex.put($sibling.ID, true))##
#set($void = $collectedElements.put($sibling.ID, {"element": $sibling, "depth": $currentDepth, "source": "sibling_via_parent"}))##
#end##if(!$visitedIndex.containsKey($sibling.ID))##
#end##if($sibling.ID != $elem.ID)##
#end##foreach($sibling in $parentElem.ownedElement)##
#end##if($currentDepth <= $MAX_SIBLING_DEPTH)##
## DANACH rekursiver Aufruf aufwärts
#set($nextDepth = $currentDepth + 1)##
#collectParentElements($parentElem $maxDepth $nextDepth)##
#end##if(!$visitedIndex.containsKey($parentElem.ID))##
#end##if($elem.owner)##
#end##if($currentDepth <= $maxDepth)##
#end##macro(collectParentElements)##
##
